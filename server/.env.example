# ════════════════════════════════════════════
# Velour AI Chatbot v2 — Backend Environment
# ════════════════════════════════════════════
# 1. cp .env.example .env
# 2. Fill in your values
# 3. NEVER commit .env to Git!

# ── REQUIRED ──────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── APP ───────────────────────────────────────
ENVIRONMENT=development
PORT=8000
ADMIN_PASSWORD=velour-admin-2025   # Change this!

# ── CORS ──────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── RATE LIMITING ─────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── OPENAI ────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.7

# ── LOGGING ───────────────────────────────────
LOG_CHAT_TO_FILE=true
CHAT_LOG_FILE=logs/chat_history.jsonl
LEADS_LOG_FILE=logs/leads.jsonl

# ── GOOGLE SHEETS (optional) ──────────────────
# Step 1: Create a Service Account in Google Cloud Console
# Step 2: Share your spreadsheet with the service account email
# Step 3: Either set the file path OR paste the JSON content below

# Option A — path to downloaded credentials JSON file:
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json

# Option B — paste the entire JSON as a single-line string:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads
